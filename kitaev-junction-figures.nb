   3.9769233238570213`*^9}},ExpressionUUID->"feea1120-3845-4b64-93c1-\
adcf3775bbbd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "purity", " ", "of", " ", "the", " ", "transmon", " ", 
    "subsystem", " ", "as", " ", "the", " ", "magnitude", " ", "of", " ", 
    "its", " ", "Bloch", " ", "vector"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"purity", "[", 
     RowBox[{"initialState_", ",", " ", "consts_"}], "]"}], " ", ":=", 
    RowBox[{"Norm", "@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"densityMatrix", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"transmon", "->", "\"\<transmonX\>\""}], ",", " ", 
             RowBox[{"chains", "->", "\"\<eveneven+oddodd\>\""}]}], "}"}], ",",
            "consts"}], "]"}], ".", 
         RowBox[{
          RowBox[{"soln", "[", 
           RowBox[{"initialState", ",", "consts"}], "]"}], "[", "t", "]"}]}], 
        "]"}], ",", "  ", 
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"densityMatrix", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"transmon", "->", "\"\<transmonY\>\""}], ",", " ", 
             RowBox[{"chains", "->", "\"\<eveneven+oddodd\>\""}]}], "}"}], ",",
            "consts"}], "]"}], ".", 
         RowBox[{
          RowBox[{"soln", "[", 
           RowBox[{"initialState", ",", "consts"}], "]"}], "[", "t", "]"}]}], 
        "]"}], ",", 
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"densityMatrix", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"transmon", "->", "\"\<transmonZ\>\""}], ",", " ", 
             RowBox[{"chains", "->", "\"\<eveneven+oddodd\>\""}]}], "}"}], ",",
            "consts"}], "]"}], ".", 
         RowBox[{
          RowBox[{"soln", "[", 
           RowBox[{"initialState", ",", "consts"}], "]"}], "[", "t", "]"}]}], 
        "]"}]}], "}"}]}]}], ";"}]}]], "Input",
