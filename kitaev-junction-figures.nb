Cell[CellGroupData[{

Cell["Solve system", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9558392485944967`*^9, 
  3.955839276920356*^9}},ExpressionUUID->"1dc2afa3-f66c-4b21-9b88-\
ffa12043d001"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"masterEquation", "[", 
     RowBox[{"t_", ",", "initialStates_", ",", "consts_"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Rho]", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          RowBox[{"MCommutator", "[", 
           RowBox[{
            RowBox[{"hTotal", "[", "consts", "]"}], ",", 
            RowBox[{"\[Rho]", "[", "t", "]"}]}], "]"}]}], " ", "+", 
         RowBox[{"\[Alpha]", " ", 
          RowBox[{"Dissipator", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"hDissip", "[", "consts", "]"}], "/.", " ", "consts"}], ",", 
            RowBox[{"\[Rho]", "[", "t", "]"}]}], "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"densityMatrix", "[", 
         RowBox[{"initialStates", ",", "consts"}], "]"}], "==", 
        RowBox[{"\[Rho]", "[", "0", "]"}]}]}], "}"}], "/.", "consts"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "master", " ", "equation", " ", "for", " ", "the", " ", 
     "full", " ", "system", " ", "dynamics", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Eq", ".", " ", "27"}], " ", "in", " ", "paper"}], ")"}], ".",
       " ", "We"}], " ", "use", " ", "this", " ", "same", " ", "equation", " ",
      "with", " ", "\[Alpha]"}], " ", "=", " ", 
    RowBox[{"0", " ", "to", " ", "compute", " ", "the", " ", "unitary", " ", 
     RowBox[{"dynamics", "."}]}]}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "soln", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"soln", "[", 
   RowBox[{"initialStates_", ",", " ", "consts_"}], "]"}], " ", ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"soln", "[", 
    RowBox[{"initialStates", ",", " ", "consts"}], "]"}], " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "t", "}"}], ",", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"masterEquation", "[", 
        RowBox[{"t", ",", "initialStates", ",", " ", "consts"}], "]"}], ",", 
       "\[Rho]", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"tMax", " ", "/.", " ", "consts"}]}], "}"}]}], "]"}]}], 
    "]"}]}]}]}], "Input",
