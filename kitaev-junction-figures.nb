   3.955839128008149*^9, 3.955839195907991*^9}, {3.976922162602377*^9, 
   3.976922204723131*^9}},ExpressionUUID->"011736d7-0aca-4181-938d-\
8d43764fb1c8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NUMBEROFBANDS", " ", "=", " ", "2"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H", "[", "consts_", "]"}], "[", "\[Phi]", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"eC", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"u", "''"}], "[", "\[Phi]", "]"}]}], " ", "+", " ", 
       RowBox[{"2", "\[ImaginaryI]", " ", "k", " ", 
        RowBox[{
         RowBox[{"u", "'"}], "[", "\[Phi]", "]"}]}], " ", "+", " ", 
       RowBox[{
        SuperscriptBox["k", "2"], " ", 
        RowBox[{"u", "[", "\[Phi]", "]"}]}]}], ")"}]}], " ", "-", " ", 
    RowBox[{"eJ", " ", 
     RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
     RowBox[{"u", "[", "\[Phi]", "]"}]}]}], " ", "/.", " ", "consts"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigenVals", "[", "consts_", "]"}], " ", ":=", " ", 
  RowBox[{"NDEigenvalues", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"H", "[", "consts", "]"}], "[", "\[Phi]", "]"}], ",", 
      RowBox[{
       RowBox[{"u", "[", "\[Pi]", "]"}], "==", 
       RowBox[{"u", "[", 
        RowBox[{"-", "\[Pi]"}], "]"}]}]}], "}"}], ",", " ", 
    RowBox[{"u", "[", "\[Phi]", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Phi]", ",", 
      RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", "NUMBEROFBANDS"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"band", "[", "i_", "]"}], " ", ":=", 
   RowBox[{
    RowBox[{"band", "[", "i", "]"}], " ", "=", " ", 
    RowBox[{"Interpolation", "[", "\[IndentingNewLine]", "\t\t", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{
          RowBox[{"eigenVals", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"eC", "->", " ", "1.0"}], ",", " ", 
             RowBox[{"eJ", " ", "->", "1.0"}]}], "}"}], "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"-", "0.5"}], ",", "0.5", ",", "0.01"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}]}], 
  ";"}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 InitializationCell->True,
