    RowBox[{"n_", "?", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"IntegerQ", "[", "#", "]"}], " ", "&&", " ", 
        RowBox[{"Positive", "[", "#", "]"}]}], " ", "&"}], ")"}]}], ",", " ", 
    "consts_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"evecs", " ", "=", " ", 
       RowBox[{"Normalize", "/@", 
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"Transpose", "[", " ", 
           RowBox[{"Eigensystem", "[", 
            RowBox[{"HBdG", "[", 
             RowBox[{"n", ",", "consts"}], "]"}], "]"}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ",", " ", "matSplit", ",",
       " ", "matPH"}], "}"}], " ", ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "UBdG", " ", "in", " ", "a", " ", "unitary", " ", "matrix", " ", "that", 
      " ", "diagonalises", " ", "HBdD", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Eq", ".", " ", "C12"}], " ", "in", " ", "paper"}], ")"}], 
       "."}]}], " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"matSplit", " ", "=", " ", 
      RowBox[{"Reverse", "[", 
       RowBox[{"evecs", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "n"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"matPH", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", "~", "Join", "~", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"J", "[", "n", "]"}], "/@", 
            RowBox[{
             RowBox[{"(", "#", ")"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", "n"}], "]"}], "]"}]}], ")"}]}], ")"}], "&"}],
        "@", "matSplit"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Explictly", " ", "enforce", " ", "particle"}], "-", 
       RowBox[{"hole", " ", 
        RowBox[{"symmetry", ".", " ", "I", ".", "e", ".", " ", "the"}], " ", 
        "columns", " ", "in", " ", "the", " ", "second", " ", "half", " ", 
        "of", " ", "UBdG", " ", "are", " ", "related", " ", "to", " ", "the", 
        " ", "columns", " ", "of", " ", "the", " ", "first", " ", "half", " ",
         "by", " ", "charge", " ", "conjugation", " ", 
        RowBox[{"J", ".", " ", "This"}], " ", "uniquely", " ", "sets", " ", 
        "the", " ", "order", " ", "of", " ", "the", " ", "columns", " ", "of",
         " ", 
        RowBox[{"UBdG", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
