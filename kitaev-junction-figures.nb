Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"tFinal", "=", "3"}], ",", "\[IndentingNewLine]", 
     RowBox[{"initialState", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"transmon", "->", "\"\<\[Psi]0\>\""}], ",", " ", 
        RowBox[{"chains", "->", "\"\<eveneven+oddodd\>\""}]}], "}"}]}], ",", 
     RowBox[{"complimentaryState", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"transmon", "->", "\"\<\[Psi]1\>\""}], ",", " ", 
        RowBox[{"chains", "->", "\"\<eveneven+oddodd\>\""}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"consts", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"nMax", "->", "5"}], ",", 
        RowBox[{"tMax", "->", "tFinal"}], ",", 
        RowBox[{"eC", "->", "0.005"}], ",", 
        RowBox[{"eJ", "->", "1"}], ",", 
        RowBox[{"ng", "->", "0"}], ",", 
        RowBox[{"\[CapitalDelta]", "->", "12"}], ",", 
        RowBox[{"w", "->", "3"}]}], "}"}]}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Callout", "[", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"densityMatrix", "[", 
            RowBox[{"initialState", ",", 
             RowBox[{"Append", "[", 
              RowBox[{"consts", ",", 
               RowBox[{"\[Alpha]", "->", "0"}]}], "]"}]}], "]"}], ".", 
           RowBox[{
            RowBox[{"soln", "[", 
             RowBox[{"initialState", ",", 
              RowBox[{"Append", "[", 
               RowBox[{"consts", ",", 
                RowBox[{"\[Alpha]", "->", "0"}]}], "]"}]}], "]"}], "[", "t", 
            "]"}]}], "]"}], 
         ",", "\"\<Tr(\!\(\*SubscriptBox[\(\[Rho]\), \(0\)]\)\[Rho](t))\>\"", 
         ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0.25"}], "}"}], ",", 
         RowBox[{"Scaled", "[", "0.32", "]"}], ",", 
         RowBox[{"FrameMargins", "->", "1"}], ",", " ", 
         RowBox[{"CalloutStyle", "->", " ", 
          TemplateBox[<|"color" -> RGBColor[0.368417, 0.506779, 0.709798]|>,
           "RGBColorSwatchTemplate"]}], ",", " ", 
         RowBox[{"LabelStyle", "->", " ", 
          TemplateBox[<|"color" -> RGBColor[0.368417, 0.506779, 0.709798]|>,
           "RGBColorSwatchTemplate"]}], ",", " ", 
         RowBox[{"CalloutMarker", "->", "\"\<Circle\>\""}]}], "]"}], ",", 
       RowBox[{"Callout", "[", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"densityMatrix", "[", 
            RowBox[{"complimentaryState", ",", 
             RowBox[{"Append", "[", 
