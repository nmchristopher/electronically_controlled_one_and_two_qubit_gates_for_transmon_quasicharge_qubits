Cell[CellGroupData[{

Cell["Figure 3: Fractional Josephson effect", "Section",
 CellChangeTimes->{{3.9609436713501062`*^9, 3.9609436985896053`*^9}, {
  3.976921774397303*^9, 
  3.976921791374466*^9}},ExpressionUUID->"c93c8d43-e9b4-4e96-8c5c-\
53dc9c55f914"],

Cell["\<\
Creating a plot illustrating the protected level crossing of eigenstates of \
the effective Hamiltonian in the groundstate space for the fractional \
Josephson effect.\
\>", "Text",
 CellChangeTimes->{{3.960943721930732*^9, 3.960943796091928*^9}, {
  3.976921817896902*^9, 
  3.9769218236853247`*^9}},ExpressionUUID->"f5f0fded-614e-4223-a0b1-\
2a5739a40c26"],

Cell[CellGroupData[{

Cell[TextData[{
 "Define eigenstates of the junction fermion occupation operator, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["g", "^"], "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0bff315d-f18b-4b2d-af21-8cfd83f694b9"],
 "\[ConjugateTranspose] ",
 Cell[BoxData[
  FormBox[
