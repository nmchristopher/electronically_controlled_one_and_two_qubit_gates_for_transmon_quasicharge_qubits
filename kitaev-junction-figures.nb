Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"blockX", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "n"}], "}"}]}], "]"}], 
        RowBox[{"IdentityMatrix", "[", "n", "]"}]},
       {
        RowBox[{"IdentityMatrix", "[", "n", "]"}], 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}
      }], ")"}], "//", "ArrayFlatten"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"J", "[", 
     RowBox[{"n_", "?", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", "#", "]"}], " ", "&&", " ", 
         RowBox[{"Positive", "[", "#", "]"}]}], "&"}], ")"}]}], "]"}], " ", ":=",
     " ", 
    RowBox[{
     RowBox[{
      RowBox[{"blockX", "[", "n", "]"}], ".", 
      RowBox[{"Conjugate", "[", "#", "]"}]}], "&"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "J", " ", "is", " ", "a", " ", "charge", " ", "conjugation", " ", 
     "operator", " ", "on", " ", "n"}], "-", 
    RowBox[{"site", " ", "Nambu", " ", 
     RowBox[{"spinors", ".", " ", "J"}], " ", "swaps", " ", "spinor", " ", 
     "components", " ", "and", " ", "complex", " ", "conjugates", " ", 
     "element"}], "-", "wise"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AMatrix", "[", 
    RowBox[{
     RowBox[{"n_", "?", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", "#", "]"}], " ", "&&", " ", 
         RowBox[{"Positive", "[", "#", "]"}], " ", "&&", " ", 
         RowBox[{"#", " ", ">", " ", "1"}]}], " ", "&"}], ")"}]}], ",", " ", 
     "consts_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["\[Mu]", "2"]}], ",", " ", "n"}], "]"}], "]"}], " ", "-",
      " ", 
