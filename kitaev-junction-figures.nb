      FractionBox["t", "2"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", 
            RowBox[{"n", "-", "1"}]}], "]"}], ",", " ", 
          RowBox[{"+", "1"}]}], "]"}], " ", "+", " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"n", "-", "1"}]}], "]"}], ",", " ", 
          RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}], " ", "/.", " ", 
    "consts"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BMatrix", "[", 
    RowBox[{
     RowBox[{"n_", "?", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", "#", "]"}], " ", "&&", " ", 
         RowBox[{"Positive", "[", "#", "]"}], " ", "&&", " ", 
         RowBox[{"#", " ", ">", " ", "1"}]}], " ", "&"}], ")"}]}], ",", 
     "consts_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     FractionBox["\[CapitalDelta]", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", " ", 
           RowBox[{"n", "-", "1"}]}], "]"}], ",", " ", 
         RowBox[{"+", "1"}]}], "]"}], " ", "+", " ", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"n", "-", "1"}]}], "]"}], ",", " ", 
