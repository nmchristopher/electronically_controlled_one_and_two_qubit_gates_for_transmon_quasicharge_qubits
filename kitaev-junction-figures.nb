Cell[TextData[{
 "Solve transmon system with the quasicharge degree of freedom ",
 Cell[BoxData[
 "k"], "InlineCode",ExpressionUUID->"27a1474e-e8d2-4470-bf6c-ce8a15674469"],
 "."
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
