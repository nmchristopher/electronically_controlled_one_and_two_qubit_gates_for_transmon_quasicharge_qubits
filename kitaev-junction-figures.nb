Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hTransmon", "[", "consts_", "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"16", " ", "eC", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", ".", "#"}], "&"}], ")"}], "@", 
