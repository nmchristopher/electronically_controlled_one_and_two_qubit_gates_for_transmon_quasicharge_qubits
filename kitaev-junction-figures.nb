Cell[CellGroupData[{

Cell["\<\
Compute the purity of the \[OpenCurlyQuote]transmon\[CloseCurlyQuote] \
subsystem (recall the dofs are mixed in the new frame; see IIE of paper for \
details) .\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10002.},
 CellChangeTimes->{{3.968805572099155*^9, 3.96880559203443*^9}, 
