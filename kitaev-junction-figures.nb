Cell[CellGroupData[{

Cell["Write leakage formula in terms of above coefficients.", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.9634476293005733`*^9, 3.9634476441369543`*^9}, 
   3.963449650563539*^9},ExpressionUUID->"0a8a30a1-71fe-4661-8427-\
4bdd2908c613"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"leakage", "[", 
    RowBox[{"n_", ",", " ", "consts_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"A", " ", 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"expi\[Phi]on2Element", "[", 
                 RowBox[{"1", ",", "f", ",", "consts"}], "]"}], " ", 
                RowBox[{"\[Alpha]", "[", 
                 RowBox[{"i", ",", "n", ",", "consts"}], "]"}], 
                RowBox[{"\[Phi]", "[", 
                 RowBox[{"j", ",", "n", ",", "consts"}], "]"}]}], " ", "-", 
               " ", 
               RowBox[{
                RowBox[{"expMinusi\[Phi]on2Element", "[", 
                 RowBox[{"1", ",", "f", ",", "consts"}], "]"}], 
                RowBox[{"\[Beta]", "[", 
                 RowBox[{"j", ",", "n", ",", "consts"}], "]"}], 
                RowBox[{"\[Psi]", "[", 
                 RowBox[{"i", ",", "n", ",", "consts"}], "]"}]}]}], "]"}], 
             "2"], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "2", ",", " ", "n"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", "2", ",", " ", "n"}], "}"}]}], "]"}], " ",
           "+", " ", 
          RowBox[{
           FractionBox["1", "2"], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sum", "[", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"expi\[Phi]on2Element", "[", 
                    RowBox[{"1", ",", "f", ",", "consts"}], "]"}], 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"\[Phi]", "[", 
                    RowBox[{"1", ",", "n", ",", "consts"}], "]"}], "+", 
                    RowBox[{"\[Beta]", "[", 
                    RowBox[{"1", ",", "n", ",", "consts"}], "]"}]}], ")"}], 
                   RowBox[{"\[Alpha]", "[", 
                    RowBox[{"i", ",", "n", ",", "consts"}], "]"}]}], "-", 
                  RowBox[{
                   RowBox[{"expMinusi\[Phi]on2Element", "[", 
                    RowBox[{"1", ",", "f", ",", "consts"}], "]"}], 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"\[Phi]", "[", 
                    RowBox[{"1", ",", "n", ",", "consts"}], "]"}], "+", 
                    RowBox[{"\[Beta]", "[", 
                    RowBox[{"1", ",", "n", ",", "consts"}], "]"}]}], ")"}], 
                   RowBox[{"\[Psi]", "[", 
                    RowBox[{"i", ",", "n", ",", "consts"}], "]"}]}]}], "]"}], 
                "2"], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", " ", "2", ",", " ", "n"}], "}"}]}], "]"}], 
             " ", "+", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"expi\[Phi]on2Element", "[", 
                    RowBox[{"1", ",", "f", ",", "consts"}], "]"}], 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"\[Psi]", "[", 
                    RowBox[{"1", ",", "n", ",", "consts"}], "]"}], "-", 
                    RowBox[{"\[Alpha]", "[", 
                    RowBox[{"1", ",", "n", ",", "consts"}], "]"}]}], ")"}], 
                   RowBox[{"\[Phi]", "[", 
                    RowBox[{"j", ",", "n", ",", "consts"}], "]"}]}], "+", 
                  RowBox[{
                   RowBox[{"expMinusi\[Phi]on2Element", "[", 
                    RowBox[{"1", ",", "f", ",", "consts"}], "]"}], 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"\[Psi]", "[", 
                    RowBox[{"1", ",", "n", ",", "consts"}], "]"}], "-", 
                    RowBox[{"\[Alpha]", "[", 
                    RowBox[{"1", ",", "n", ",", "consts"}], "]"}]}], ")"}], 
                   RowBox[{"\[Beta]", "[", 
                    RowBox[{"j", ",", "n", ",", "consts"}], "]"}]}]}], "]"}], 
                "2"], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", " ", "2", ",", " ", "n"}], "}"}]}], "]"}]}],
             ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"f", ",", "1", ",", 
           RowBox[{"nMax", " ", "/.", "consts"}]}], "}"}]}], "]"}], " ", "+", 
       " ", 
       RowBox[{
        FractionBox["1", "4"], " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"\[Psi]", "[", 
                 RowBox[{"1", ",", "n", ",", "consts"}], "]"}], " ", "-", " ", 
                RowBox[{"\[Alpha]", "[", 
                 RowBox[{"1", ",", "n", ",", "consts"}], "]"}]}], ")"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"\[Phi]", "[", 
