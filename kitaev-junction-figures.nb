Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Function", " ", "shorthands"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"MCommutator", " ", "[", 
      RowBox[{"A_", ",", "B_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Commutator", "[", 
      RowBox[{"A", ",", "B", ",", 
       RowBox[{"{", 
        RowBox[{"Dot", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Dissipator", "[", 
      RowBox[{"A_", ",", "B_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"A", ".", "B", ".", 
       RowBox[{"A", "\[ConjugateTranspose]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"B", ".", 
          RowBox[{"A", "\[ConjugateTranspose]"}], ".", "A"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"A", "\[ConjugateTranspose]"}], ".", "A", ".", "B"}]}], 
        ")"}], "/", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FirstTwoEigensystem", "[", 
      RowBox[{"A_", "?", "SquareMatrixQ"}], "]"}], " ", ":=", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Extract", "[", 
        RowBox[{"1", ";;", "2"}], "]"}], "@*", 
       RowBox[{"SortBy", "[", "First", "]"}], "@*", "Transpose", "@*", 
       "Eigensystem"}], " ", "@", " ", "A"}]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"VKroneckerProduct", "[", 
      RowBox[{"vecs__", "?", "VectorQ"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Flatten", "@*", "KroneckerProduct"}], "@", "vecs"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Operator", " ", "shorthands"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"id", ",", " ", "X", ",", " ", "Y", ",", " ", "Z"}], "}"}], " ",
      "=", " ", 
     RowBox[{"PauliMatrix", " ", "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "3"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c2", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"X", " ", "+", " ", 
         RowBox[{"\[ImaginaryI]", " ", "Y"}]}], "2"], ",", " ", "id"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c3", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"Z", ",", 
       FractionBox[
        RowBox[{"X", " ", "+", " ", 
         RowBox[{"\[ImaginaryI]", " ", "Y"}]}], "2"]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Fermion", " ", "operators", " ", "from", " ", "Jordan"}], "-", 
     "Wigner"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SG", "[", 
      RowBox[{"nMax_", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"IntegerQ", "[", "#", "]"}], " ", "&&", " ", 
          RowBox[{"Positive", "[", "#", "]"}]}], "&"}], ")"}]}], "]"}], " ", ":=",
      " ", 
     RowBox[{"DiagonalMatrix", "[", " ", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"1", ",", 
         RowBox[{"2", "nMax"}]}], "]"}], ",", "1"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Susskind", "-", 
     RowBox[{"Glogower", " ", "operator", " ", 
      RowBox[{
       TemplateBox[<|"boxes" -> FormBox[
           SuperscriptBox[
            StyleBox["e", "TI"], 
            RowBox[{
              StyleBox["i", "TI"], "\[Phi]", "/", "2"}]], TraditionalForm], 
         "errors" -> {}, "input" -> "$e^{i\\phi/2}$", "state" -> "Boxes"|>,
        "TeXAssistantTemplate"], ".", " ", "Remember"}], " ", "our", " ", 
      "charge", " ", "basis", " ", "is", " ", "doubled", " ", "due", " ", 
      "to", " ", "coupling", " ", "of", " ", "the", " ", "transmon", " ", 
      "to", " ", "the", " ", "4", "\[Pi]"}], "-", 
     RowBox[{"junction", "!"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"nOp", "[", 
      RowBox[{"nMax_", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"IntegerQ", "[", "#", "]"}], " ", "&&", " ", 
          RowBox[{"Positive", "[", "#", "]"}]}], "&"}], ")"}]}], "]"}], " ", ":=",
      " ", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"-", "nMax"}], ",", "nMax"}], "]"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 InitializationCell->True,
